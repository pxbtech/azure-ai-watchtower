<!--
  AI Watchtower governed API policy (v1.2)
  Placeholders substituted at publish time:
    {DEPLOYMENT_NAME}, {MODEL_NAME}, {BACKEND_ID}, {FOUNDRY_ENDPOINT}
    {APP_NAME}, {APP_OWNER}, {APP_TEAM}, {BUSINESS_UNIT}, {ENVIRONMENT}, {COST_CENTER}
    {TPM_LIMIT} - tokens per minute per consumer
    {RPM_LIMIT} - requests per minute per consumer
-->
<policies>
  <inbound>
    <base />

    <!-- 1. Suspension gate -->
    <set-variable name="suspendedCsv" value="{{watchtower-suspended-deployments}}" />
    <choose>
      <when condition="@(((string)context.Variables["suspendedCsv"]).Split(',').Select(s => s.Trim()).Contains("{DEPLOYMENT_NAME}"))">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@{ return "{\"error\":{\"code\":\"watchtower_suspended\",\"message\":\"Deployment {DEPLOYMENT_NAME} is suspended by AI Watchtower.\"}}"; }</set-body>
        </return-response>
      </when>
    </choose>

    <!-- 2. Metadata headers on the way in - visible in gateway logs & backend logs -->
    <set-header name="X-App-Name" exists-action="override"><value>{APP_NAME}</value></set-header>
    <set-header name="X-App-Owner" exists-action="override"><value>{APP_OWNER}</value></set-header>
    <set-header name="X-App-Team" exists-action="override"><value>{APP_TEAM}</value></set-header>
    <set-header name="X-Business-Unit" exists-action="override"><value>{BUSINESS_UNIT}</value></set-header>
    <set-header name="X-Environment" exists-action="override"><value>{ENVIRONMENT}</value></set-header>
    <set-header name="X-Cost-Center" exists-action="override"><value>{COST_CENTER}</value></set-header>
    <set-header name="X-Watchtower-Deployment" exists-action="override"><value>{DEPLOYMENT_NAME}</value></set-header>

    <!-- 3. Streaming usage injection so metering is accurate under stream=true -->
    <set-variable name="reqBody" value="@(context.Request.Body?.As<string>(preserveContent: true) ?? "")" />
    <choose>
      <when condition="@(((string)context.Variables["reqBody"]).Contains("\"stream\":true") || ((string)context.Variables["reqBody"]).Contains("\"stream\": true"))">
        <set-body>@{
          var body = (string)context.Variables["reqBody"];
          if (!body.Contains("stream_options")) {
            body = body.TrimEnd('}') + ",\"stream_options\":{\"include_usage\":true}}";
          }
          return body;
        }</set-body>
      </when>
    </choose>

    <!-- 4. Resolve consumer -->
    <set-variable name="consumerId" value="@(context.Subscription?.Id ?? "anonymous")" />

    <!-- 5. Per-minute REQUEST throttling (RPM) -->
    <rate-limit-by-key
        calls="{RPM_LIMIT}"
        renewal-period="60"
        counter-key="@((string)context.Variables["consumerId"])" />

    <!-- 6. Per-minute TOKEN ceiling (TPM) -->
    <azure-openai-token-limit
        counter-key="@((string)context.Variables["consumerId"])"
        tokens-per-minute="{TPM_LIMIT}"
        estimate-prompt-tokens="true"
        tokens-consumed-header-name="x-tokens-consumed"
        remaining-tokens-header-name="x-tokens-remaining" />

    <!-- 7. Emit per-request token metrics - dimensions unlock per-team/env/BU billing -->
    <azure-openai-emit-token-metric namespace="ai-watchtower">
      <dimension name="DeploymentName" value="{DEPLOYMENT_NAME}" />
      <dimension name="ConsumerId"     value="@((string)context.Variables["consumerId"])" />
      <dimension name="ModelName"      value="{MODEL_NAME}" />
      <dimension name="AppName"        value="{APP_NAME}" />
      <dimension name="AppTeam"        value="{APP_TEAM}" />
      <dimension name="BusinessUnit"   value="{BUSINESS_UNIT}" />
      <dimension name="Environment"    value="{ENVIRONMENT}" />
      <dimension name="CostCenter"     value="{COST_CENTER}" />
    </azure-openai-emit-token-metric>

    <!-- 8. Backend auth via managed identity. No keys. -->
    <authentication-managed-identity resource="https://cognitiveservices.azure.com"
                                     output-token-variable-name="msi-token"
                                     ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["msi-token"])</value>
    </set-header>
    <set-header name="api-key" exists-action="delete" />

    <set-backend-service backend-id="{BACKEND_ID}" />
  </inbound>

  <backend>
    <forward-request buffer-response="true" />
  </backend>

  <outbound>
    <base />
    <set-header name="X-Watchtower-Deployment" exists-action="override"><value>{DEPLOYMENT_NAME}</value></set-header>
    <set-header name="X-App-Team" exists-action="override"><value>{APP_TEAM}</value></set-header>
  </outbound>

  <on-error>
    <base />
  </on-error>
</policies>
