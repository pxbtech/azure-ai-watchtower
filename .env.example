# AI Watchtower configuration
# Copy this file to .env for local dev; production values are set via App Service
# application settings by the Bicep template.
#
# Load in bash:        export $(cat .env | xargs)
# Load in PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^([^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }

# ---- Azure tenancy (required) ----
WATCHTOWER_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
WATCHTOWER_RESOURCE_GROUP=rg-my-aihub
WATCHTOWER_LOCATION=eastus2

# ---- Existing Azure resources (required) ----
# These must exist in WATCHTOWER_RESOURCE_GROUP before deploying AI Watchtower.
WATCHTOWER_FOUNDRY_ACCOUNT=my-foundry-account
WATCHTOWER_APIM_SERVICE=my-apim-service
WATCHTOWER_KEY_VAULT=my-key-vault

# Optional: existing Content Safety account for llm-content-safety APIM policy.
# Leave blank to skip that policy fragment.
WATCHTOWER_CONTENT_SAFETY_ACCOUNT=

# ---- Managed identity (auto-set by Bicep in Azure; only needed for local dev) ----
# For local dev, use az login instead (DefaultAzureCredential will pick it up)
# and leave this blank.
WATCHTOWER_MANAGED_IDENTITY_CLIENT_ID=

# ---- Persistence ----
# SQLite (default, dev only)
WATCHTOWER_DB_PATH=/home/data/watchtower.db

# Postgres (recommended for anything beyond local dev; overrides db_path when set)
# Format:   postgresql+asyncpg://<user>:<pass>@<fqdn>:5432/<db>?ssl=require
WATCHTOWER_DATABASE_URL=

# ---- CORS ----
# Comma-separated origins. "*" for wide open. Set to your frontend URL in prod.
WATCHTOWER_CORS_ORIGINS=*

# ---- Azure SDK auth (for local dev) ----
# DefaultAzureCredential resolves in order: env vars > MI > Az CLI > VS Code > ...
# Simplest path for local dev is `az login --tenant <your-tenant-id>`.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
